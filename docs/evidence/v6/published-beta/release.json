d_url":"https://github.com/3d3dcanada/alt-cli/releases/download/v0.6.0-beta.1/dependency-audit.json"},{"url":"https://api.github.com/repos/3d3dcanada/alt-cli/releases/assets/617416233","id":617416233,"node_id":"RA_kwDOU9TKCs4kzQYp","name":"release-gate.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":25897,"digest":"sha256:41394b40c48796491dacf8f115c0e3fefb94b34798b3ea66fc902c30bfad5fd1","download_count":0,"created_at":"2026-10-07T03:12:08Z","updated_at":"2026-10-07T03:12:08Z","browser_download_url":"https://github.com/3d3dcanada/alt-cli/releases/download/v0.6.0-beta.1/release-gate.json"}],"tarball_url":"https://api.github.com/repos/3d3dcanada/alt-cli/tarball/v0.6.0-beta.1","zipball_url":"https://api.github.com/repos/3d3dcanada/alt-cli/zipball/v0.6.0-beta.1","body":"Alt 0.6 adds a complete practice repair workflow, tool instructions matched to\nthe selected focus, clearer check setup, better bounded retrieval and tested\nstream/disconnect recovery. Package updates preserve a pre-upgrade state backup.\n\nDownload `alt-0.6.0-linux-x86_64.tar.gz` and its checksum. This is a Linux x86_64\nbeta; the frontend needs glibc 2.30+. Python 3 is required for installation and\nthe practice checks. Models and inference runtimes are chosen separately in Alt.\n\nVerify the archive's GitHub attestation using the accompanying Sigstore bundle:\n\n```bash\ngh attestation verify alt-0.6.0-linux-x86_64.tar.gz \\\n  --repo 3d3dcanada/alt-cli \\\n  --bundle alt-0.6.0-linux-x86_64.tar.gz.sigstore.jsonl \\\n  --signer-workflow 3d3dcanada/alt-cli/.github/workflows/publish.yml \\\n  --source-ref refs/tags/v0.6.0-beta.1\nsha256sum -c alt-0.6.0-linux-x86_64.tar.gz.sha256\ntar -xzf alt-0.6.0-linux-x86_64.tar.gz\ncd alt-0.6.0-linux-x86_64\nbash install.sh\n~/.local/bin/alt\n```\n\nStart with **Try a practice project** on Home. The included `test-my-pc.py`\nrecords build/hardware results; add `--live` only after selecting an uncensored\nmodel. Nothing is uploaded automatically.\n\nCloud validation includes 93 Rust tests, real terminal journeys, 60 streamed\nrecovery scenarios and prior-version installation/rollback checks. Full CPU model\ncampaigns passed 7/120 frozen behavioral checks for Spark-X2.5 abliterated and\n16/120 for Qwen3-4B Heretic. Those configurations use different time/reasoning\nbudgets; these counts are not a matched comparison. All 240 saved responses were\nreviewed and sources replayed. Additional edge cases exposed incomplete repairs\namong passes. Treat this as a supervised beta and verify model changes with checks.\n\nThe attached release-gate report covers the exact package and prior-version\nrecovery. That report was captured before publication; its `published` and private-key\n`signature_verified` fields describe that stage. The separate GitHub attestation\nbundle and `attestation-verification.json` record workflow-identity verification.\nReview the repository's implementation report for model scores and\nremaining acceptance gates. Physical GTX 1070 and human beginner qualification\nremain outstanding; this beta does not promise arbitrary task success.\n"}