{"data":{"sessionId":"20261007_1","update":{"_meta":{"goose":{"created":1791333671,"messageId":"chatcmpl-1YqlW9OFo1uJZRf4ZARqWXtVyJJxkNYS","toolCall":{"extensionName":"alt","toolName":"alt__edit"}}},"rawInput":{"new_text":"def order(dependencies):\n    \"\"\"Order nodes in dependency order.\n\n    Each node is mapped to the names of its dependencies. Return a list\n    with each dependency before its node, including dependency-only nodes.\n\n    Raise ValueError if the dependency graph contains cycles.\n    \"\"\"\n    order = []\n    visited = set()\n    in_stack = set()\n    for node in dependencies:\n        if node in visited:\n            continue\n        in_stack.add(node)\n        order.append(node)\n\n        if node in dependencies.get(node, []):\n            for dep in dependencies.get(node, []):\n                if dep not in order:\n                    order.append(dep)\n\n        if node not in in_stack:\n            visited.add(node)\n\n    while in_stack:\n        node = in_stack.pop()\n        for dep in dependencies.get(node, []):\n            if dep not in order:\n                order.append(dep)\n                if dep not in visited:\n                    visited.add(dep)\n                    in_stack.add(dep)\n\n    return order","old_text":"def order(dependencies):return list(dependencies)","operation":"replace","path":"solution.py","reason":"Implement order(dependencies) as a dependency-ordering function that maps each node to its dependency names, returns each dependency before its node (including dependency-only nodes), and raises ValueError on cycles."},"sessionUpdate":"tool_call","title":"alt: edit · solution.py","toolCallId":"57z0G5zPVPFNcc0yBrTEccZ4psFmJUs8"}},"type":"update"}
